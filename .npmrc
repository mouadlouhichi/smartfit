node-linker=hoisted
strict-peer-dependencies=false
# Ensure EAS / CI use the same pnpm lockfile version we develop with locally.
# EAS's default build image still ships pnpm 8 which cannot read a pnpm@9
# lockfile. The eas-build-pre-install hook activates pnpm@9.15.9 via corepack
# before install runs, so lockfile v9 is always honoured.
lockfile-include-tarball-url=false
