# ── SmartFit (web, root) ────────────────────────────────────────────────
# Copy to `.env.local` for local dev. NEXT_PUBLIC_* values are exposed to the
# browser (inlined at build time by Next.js). When a full Firebase config is
# present the app runs in CLOUD MODE (Firebase Auth + Cloud Firestore). When
# any required value is missing it falls back to LOCAL MODE (on-device data)
# so the app still runs in previews with no backend configured.

# App display name (used in metadata / document title).
NEXT_PUBLIC_APP_NAME=SmartFit

# Default training strategy: ppl | upper-lower | full-body | cardio-focus
NEXT_PUBLIC_DEFAULT_PLAN=full-body

# Absolute origin of this deployment. Used for canonical URLs, Open Graph
# tags, robots.txt and the sitemap. On Vercel this is inferred automatically;
# set it explicitly for a custom domain.
NEXT_PUBLIC_SITE_URL=https://smartfit.example.com

# ── Firebase (client / public) — from Firebase console → Project settings ──
# Required for cloud mode (Auth + Firestore).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional:
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# ── Abuse protection (optional but recommended before launch) ────────────
# reCAPTCHA v3 site key from Firebase console → App Check → Apps. Register
# the app, set this key, then enable enforcement for Authentication and
# Firestore. Without it the app still runs — requests are just unattested.
NEXT_PUBLIC_FIREBASE_APPCHECK_SITE_KEY=

# ── Diagnostics (optional; nothing is sent when empty) ───────────────────
# URL of a SELF-HOSTED, cookie-free collector (e.g. GlitchTip/Sentry ingest
# or a small log function). Crash reports and web vitals are POSTed there as
# plain JSON. Leave empty to keep the zero-data promise of the privacy page.
NEXT_PUBLIC_ERROR_ENDPOINT=

# ── Billing: Stripe Payment Links (optional; sandbox when unset) ──────────
# One link per plan from the Stripe dashboard. Checkout opens in a new tab;
# see docs/billing.md for the webhook that provisions receipts for real.
NEXT_PUBLIC_STRIPE_PAYMENT_LINK_MONTHLY=
NEXT_PUBLIC_STRIPE_PAYMENT_LINK_YEARLY=
NEXT_PUBLIC_STRIPE_PAYMENT_LINK_LIFETIME=
# Optional Stripe Customer Portal session URL for self-serve management.
NEXT_PUBLIC_STRIPE_PORTAL_URL=

# ── Billing: CMI (dormant until the finance setup lands) ─────────────────
# Client flag only — the merchant secret NEVER ships to the browser.
NEXT_PUBLIC_CMI_ENABLED=
# Server-only CMI credentials for the future /api/billing/cmi/* routes.
# NEVER prefix these with NEXT_PUBLIC_ and NEVER commit real values.
CMI_STORE_ID=
CMI_STORE_KEY=
CMI_GATEWAY_URL=
CMI_OK_URL=
CMI_FAIL_URL=

# ── Firebase Admin (server-only, for scripts/seed-firestore.mjs) ──────────
# NEVER prefix these with NEXT_PUBLIC_ and NEVER commit real values.
# Use a service-account key from Firebase console → Project settings →
# Service accounts → Generate new private key.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ── Optional AI coach (off unless configured; user must also opt in) ────────
# Two ways to give the coach AI answers. Either way the on-device rule-based
# coach stays the default and the fallback, and nothing is sent anywhere until
# the athlete flips "AI answers" on in the coach UI.
#
# 1. RECOMMENDED for any deployment — the built-in proxy (/api/coach).
#    The key lives here, on the server; the browser only ever posts to this
#    app's own route, which also streams the answer back token by token.
#    Any OpenAI-compatible chat-completions base URL works. Free tiers:
#      Groq          https://api.groq.com/openai/v1            llama-3.3-70b-versatile
#      Google AI     https://generativelanguage.googleapis.com/v1beta/openai
#      OpenRouter    https://openrouter.ai/api/v1              <model>:free
#      Pollinations  https://text.pollinations.ai/openai
#    NEVER prefix AI_COACH_API_KEY with NEXT_PUBLIC_ and never commit a value.
AI_COACH_ENDPOINT=
AI_COACH_API_KEY=
# Model id, e.g. llama-3.3-70b-versatile or gemini-2.5-flash. Empty = provider default.
AI_COACH_MODEL=
#
# 2. Legacy / local only: a browser-side endpoint. NEXT_PUBLIC_* is inlined
#    into the bundle, so this key is public — fine for a keyless self-hosted
#    model (Ollama: http://localhost:11434/v1), wrong for a shared secret.
#    Used only when AI_COACH_ENDPOINT above is unset.
NEXT_PUBLIC_AI_ENDPOINT=
NEXT_PUBLIC_AI_API_KEY=
NEXT_PUBLIC_AI_MODEL=
