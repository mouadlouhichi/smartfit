# ── SmartFit — root / shared ─────────────────────────────────────────────
# Copy to `.env` (or set in your deployment). SmartFit is local-first: these
# are all OPTIONAL and have sane defaults — the app runs with no backend.

# Seed a demo training history on first run when a user has no saved data.
# Set to "false" to start every fresh install on the guided onboarding instead.
SEED_DEMO=true

# Default training strategy for brand-new accounts (see packages/core):
#   ppl | upper-lower | full-body | cardio-focus
DEFAULT_PLAN=full-body

# ── Optional cloud sync (reserved — not wired in the local-first default) ──
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=
