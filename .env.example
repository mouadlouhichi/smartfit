# Production builds fail closed without matching Firebase client/admin configuration.
# For an intentional local/demo build only, uncomment SMARTFIT_DEPLOYMENT=demo.
# Do not use demo mode for a real customer deployment.
# SMARTFIT_DEPLOYMENT=demo
# Google-hosted deployments may opt in to ADC instead of service-account secrets:
# SMARTFIT_ADMIN_ADC=true

# ── SmartFit (web, root) ────────────────────────────────────────────────
# Copy to `.env.local` for local dev. NEXT_PUBLIC_* values are exposed to the
# browser (inlined at build time by Next.js). When a full Firebase config is
# present the app runs in CLOUD MODE (Firebase Auth + Cloud Firestore). When
# any required value is missing it falls back to LOCAL MODE (on-device data)
# so the app still runs in previews with no backend configured.

# App display name (used in metadata / document title).
NEXT_PUBLIC_APP_NAME=SmartFit

# Default training strategy: ppl | upper-lower | full-body | cardio-focus
NEXT_PUBLIC_DEFAULT_PLAN=full-body

# Absolute origin of this deployment. Used for canonical URLs, Open Graph
# tags, robots.txt and the sitemap. On Vercel this is inferred automatically;
# set it explicitly for a custom domain.
NEXT_PUBLIC_SITE_URL=https://smartfit.example.com

# ── B2B tenant subdomains (see docs/b2b-pivot-plan.md §8) ────────────────────
# Apex domain(s) a gym subdomain hangs off: `acme` + `smartfit.app` serves
# acme.smartfit.app. Comma-separate for a deployment answering on more than one
# apex. Leave EMPTY to disable host resolution entirely — every tenant then
# stays reachable on the canonical /g/{slug} path, which is the mode previews
# and local development use (no wildcard DNS, no certificate).
NEXT_PUBLIC_APEX_DOMAIN=
# Exact host(s) that are never tenants, comma-separated. Needed when an apex is
# loose enough that the base host itself looks like a slug: with apex `e2b.app`,
# a preview host of `8080-abc123.e2b.app` would otherwise resolve to a tenant
# called `8080-abc123` and render "gym not found" instead of the app.
NEXT_PUBLIC_BASE_HOST=

# ── Firebase (client / public) — from Firebase console → Project settings ──
# Required for cloud mode (Auth + Firestore).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional:
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# ── Abuse protection (optional but recommended before launch) ────────────
# reCAPTCHA v3 site key from Firebase console → App Check → Apps. Register
# the app, set this key, then enable enforcement for Authentication and
# Firestore. Without it the app still runs — requests are just unattested.
NEXT_PUBLIC_FIREBASE_APPCHECK_SITE_KEY=

# ── Diagnostics (optional; nothing is sent when empty) ───────────────────
# URL of a SELF-HOSTED, cookie-free collector (e.g. GlitchTip/Sentry ingest
# or a small log function). Crash reports and web vitals are POSTed there as
# plain JSON. Leave empty to keep the zero-data promise of the privacy page.
NEXT_PUBLIC_ERROR_ENDPOINT=

# ── Billing: Stripe Payment Links (optional; sandbox when unset) ──────────
# One link per plan from the Stripe dashboard. Checkout opens in a new tab;
# see docs/billing.md for the webhook that provisions receipts for real.
NEXT_PUBLIC_STRIPE_PAYMENT_LINK_MONTHLY=
NEXT_PUBLIC_STRIPE_PAYMENT_LINK_YEARLY=
NEXT_PUBLIC_STRIPE_PAYMENT_LINK_LIFETIME=
# Optional Stripe Customer Portal session URL for self-serve management.
NEXT_PUBLIC_STRIPE_PORTAL_URL=

# ── Billing: CMI (dormant until the finance setup lands) ─────────────────
# Client flag only — the merchant secret NEVER ships to the browser.
NEXT_PUBLIC_CMI_ENABLED=
# Server-only CMI credentials for the future /api/billing/cmi/* routes.
# NEVER prefix these with NEXT_PUBLIC_ and NEVER commit real values.
CMI_STORE_ID=
CMI_STORE_KEY=
CMI_GATEWAY_URL=
CMI_OK_URL=
CMI_FAIL_URL=

# ── Stripe webhook (server-only, planned — see docs/billing.md §2) ─────────
# Signs the future POST /api/billing/stripe/webhook route. Reserved until the
# provisioning webhook is built; read by nothing yet.
# STRIPE_WEBHOOK_SECRET=

# ── Firebase Admin (server-only) ─────────────────────────────────────────
# NEVER prefix these with NEXT_PUBLIC_ and NEVER commit real values.
# The account deletion API uses the FIREBASE_ADMIN_* names below. Google-hosted
# runtimes may provide GOOGLE_CLOUD_PROJECT and Application Default Credentials
# instead. Scripts (seed/grant/promote) load this .env automatically and accept
# these names, a FIREBASE_ADMIN_SERVICE_ACCOUNT blob, or the legacy FIREBASE_*
# names below.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
# Alternative to the three values above: one escaped service-account JSON blob.
FIREBASE_ADMIN_SERVICE_ACCOUNT=
# GOOGLE_CLOUD_PROJECT is normally platform-provided; set it only for local ADC.
# GOOGLE_CLOUD_PROJECT=
# Seed script credentials (see scripts/README.md).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Where `pnpm seed` writes the demo history, and the email to create the
# account with when it does not exist yet. See scripts/README.md.
SEED_UID=demo-user
SEED_EMAIL=
# `pnpm seed:b2b` — provisions the B2B demo: a platform admin, a gym owner,
# staff and members, plus one populated tenant. Idempotent.
B2B_PASSWORD=SmartFit!234
B2B_GYM_SLUG=zone-fight
B2B_ADMIN_EMAIL=admin@smartfit.app
# Set to 1 to also reset passwords on accounts that already exist.
B2B_FORCE=
# `node scripts/promote-custom-gym.mjs` — promotes one of a member's personal
# custom gyms into a real B2B tenant (nothing is moved; see scripts/README.md).
B2B_PROMOTE_UID=
B2B_PROMOTE_GYM=
# Platform plan for the promoted tenant (default starter).
B2B_PLAN=
# Set to 1 to allow merging into an existing tenant document.
B2B_PROMOTE_FORCE=

# ── AI coach (optional; used automatically once configured) ─────────────────
# Two ways to give the coach AI answers. Configure neither and the on-device
# rule-based coach answers everything — nothing is sent anywhere. Configure
# either and the coach uses it by default, falling back on-device whenever the
# provider fails, is rate-limited or has no key.
#
# 1. RECOMMENDED for any deployment — the built-in proxy (/api/coach).
#    The key lives here, on the server; the browser only ever posts to this
#    app's own route, which also streams the answer back token by token.
#    Give the BASE url (the app appends /chat/completions itself — a value that
#    already ends in /chat/completions is used as-is). Free tiers:
#      Groq          https://api.groq.com/openai/v1            llama-3.3-70b-versatile
#      Google AI     https://generativelanguage.googleapis.com/v1beta/openai
#                    (Gemini's OpenAI-compatibility layer)
#      OpenRouter    https://openrouter.ai/api/v1              <model>:free
#      Pollinations  https://gen.pollinations.ai/v1            (free key from enter.pollinations.ai)
#    The URL must be reachable FROM THE DEPLOYMENT: never localhost or a
#    private address (192.168.*, 10.*, 172.16-31.*) — a serverless function
#    cannot reach the model on your laptop. For a local model (Ollama), use the
#    browser-side NEXT_PUBLIC_ mode below instead.
#    NEVER prefix AI_COACH_API_KEY with NEXT_PUBLIC_ and never commit a value.
AI_COACH_ENDPOINT=
AI_COACH_API_KEY=
# Model id, e.g. llama-3.3-70b-versatile or gemini-2.5-flash. Empty = provider default.
AI_COACH_MODEL=
#
# 2. Legacy / local only: a browser-side endpoint. NEXT_PUBLIC_* is inlined
#    into the bundle, so this key is public — fine for a keyless self-hosted
#    model (Ollama: http://localhost:11434/v1), wrong for a shared secret.
#    Used only when AI_COACH_ENDPOINT above is unset.
NEXT_PUBLIC_AI_ENDPOINT=
NEXT_PUBLIC_AI_API_KEY=
NEXT_PUBLIC_AI_MODEL=

# Local emulators only; never set these on a real deployment. CLI injects them for tests.
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
