# ── SmartFit (web, root) ────────────────────────────────────────────────
# Copy to `.env.local` for local dev. NEXT_PUBLIC_* values are exposed to the
# browser (inlined at build time by Next.js). When a full Firebase config is
# present the app runs in CLOUD MODE (Firebase Auth + Cloud Firestore). When
# any required value is missing it falls back to LOCAL MODE (on-device data)
# so the app still runs in previews with no backend configured.

# App display name (used in metadata / document title).
NEXT_PUBLIC_APP_NAME=SmartFit

# Default training strategy: ppl | upper-lower | full-body | cardio-focus
NEXT_PUBLIC_DEFAULT_PLAN=full-body

# Absolute origin of this deployment. Used for canonical URLs, Open Graph
# tags, robots.txt and the sitemap. On Vercel this is inferred automatically;
# set it explicitly for a custom domain.
NEXT_PUBLIC_SITE_URL=https://smartfit.example.com

# ── Firebase (client / public) — from Firebase console → Project settings ──
# Required for cloud mode (Auth + Firestore).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional:
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# ── Abuse protection (optional but recommended before launch) ────────────
# reCAPTCHA v3 site key from Firebase console → App Check → Apps. Register
# the app, set this key, then enable enforcement for Authentication and
# Firestore. Without it the app still runs — requests are just unattested.
NEXT_PUBLIC_FIREBASE_APPCHECK_SITE_KEY=

# ── Diagnostics (optional; nothing is sent when empty) ───────────────────
# URL of a SELF-HOSTED, cookie-free collector (e.g. GlitchTip/Sentry ingest
# or a small log function). Crash reports and web vitals are POSTed there as
# plain JSON. Leave empty to keep the zero-data promise of the privacy page.
NEXT_PUBLIC_ERROR_ENDPOINT=

# ── Firebase Admin (server-only, for scripts/seed-firestore.mjs) ──────────
# NEVER prefix these with NEXT_PUBLIC_ and NEVER commit real values.
# Use a service-account key from Firebase console → Project settings →
# Service accounts → Generate new private key.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
