# ── SmartFit (web, root) ────────────────────────────────────────────────
# Copy to `.env.local` for local dev. All vars are OPTIONAL — the app is
# local-first and runs with no backend. Only NEXT_PUBLIC_* are exposed to the
# browser (inlined at build time by Next.js). Mobile uses EXPO_PUBLIC_* (see
# apps/mobile/.env.example).

# Seed a demo training history for first-time visitors (no saved data).
# false → fresh installs land on the guided onboarding.
NEXT_PUBLIC_SEED_DEMO=true

# Default training strategy: ppl | upper-lower | full-body | cardio-focus
NEXT_PUBLIC_DEFAULT_PLAN=full-body

# App display name (used in metadata / document title).
NEXT_PUBLIC_APP_NAME=SmartFit

# ── Optional cloud sync (reserved) ───────────────────────────────────────
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=
