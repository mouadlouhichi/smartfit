{
  "name": "smartfit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -p 3000 -H 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "web": "next dev",
    "mobile": "pnpm --filter @smartfit/mobile start",
    "mobile:android": "pnpm --filter @smartfit/mobile android",
    "mobile:ios": "pnpm --filter @smartfit/mobile ios",
    "turbo:build": "turbo run build",
    "turbo:test": "turbo run test",
    "turbo:typecheck": "turbo run typecheck",
    "seed": "node scripts/seed-firestore.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:all": "pnpm --filter @smartfit/core test && pnpm test",
    "test:e2e": "playwright test",
    "prepare": "git config core.hooksPath .githooks || true",
    "test:rules": "npx -y firebase-tools@latest emulators:exec --only firestore --project smartfit-rules-ci \"node --import tsx --test tests/rules/firestore-rules.test.ts\""
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@smartfit/core": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^12.18.0",
    "lucide-react": "^0.468.0",
    "maplibre-gl": "^6.9.0",
    "next": "^15.5.4",
    "next-themes": "^0.4.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "recharts": "^2.15.3",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.1.14",
    "@types/node": "^22.14.0",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "eslint": "^9",
    "eslint-config-next": "^15",
    "firebase-admin": "^14.3.0",
    "prettier": "^3",
    "prettier-plugin-tailwindcss": "^0.6",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.13",
    "turbo": "^2.4.0",
    "typescript": "^5.8.3"
  },
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  }
}
