{
  "name": "smartfit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -p 3000 -H 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "web": "next dev",
    "mobile": "pnpm --filter @smartfit/mobile start",
    "mobile:android": "pnpm --filter @smartfit/mobile android",
    "mobile:ios": "pnpm --filter @smartfit/mobile ios",
    "turbo:build": "turbo run build",
    "turbo:test": "turbo run test",
    "turbo:typecheck": "turbo run typecheck"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@smartfit/core": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^0.468.0",
    "next": "^15.5.4",
    "next-themes": "^0.4.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "recharts": "^2.15.3",
    "tailwind-merge": "^3.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.14",
    "@types/node": "^22.14.0",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.20.5",
    "turbo": "^2.4.0",
    "typescript": "^5.8.3"
  },
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=20"
  }
}
