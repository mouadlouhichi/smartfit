rules_version = '2';

// ── SmartFit Cloud Firestore security rules ───────────────────────────────
// Every user owns exactly one document tree under users/{uid} and may only
// read/write their own data. Nothing is world-readable.
//
// Beyond ownership, writes are validated: required fields must be present
// with sane types and bounds, and documents are capped in field count and
// string length. A compromised or scripted client can therefore not use an
// account as free junk storage, and a buggy client fails loudly at the rules
// layer instead of poisoning the data it will later read back.
//
// Deploy with:  firebase deploy --only firestore:rules,firestore:indexes
service cloud.firestore {
  match /databases/{database}/documents {

    // ── helpers ──────────────────────────────────────────────────────────
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isoDate(v) {
      return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function strAtMost(v, n) {
      return v is string && v.size() <= n;
    }

    function numBetween(v, lo, hi) {
      return v is number && v >= lo && v <= hi;
    }

    function isIntensity(v) {
      return v in ['low', 'moderate', 'high'];
    }

    // A Pro stamp is not client-mintable. A client may start the explicitly
    // local/sandbox trial, and may keep a paid stamp that was provisioned by a
    // trusted server, but it cannot create or change a monthly/yearly/lifetime
    // entitlement by editing its profile document.
    function validPro(profile) {
      return !('pro' in profile)
        || (profile.pro is map
            && profile.pro.plan == 'trial'
            && profile.pro.since is number
            && profile.pro.since > 0
            && profile.pro.size() <= 3);
    }

    function keepsServerProStamp(profile) {
      return resource.data.profile is map
        && ('pro' in resource.data.profile)
        && ('pro' in profile)
        && profile.pro == resource.data.profile.pro;
    }

    function validProWrite(profile) {
      return validPro(profile) || keepsServerProStamp(profile);
    }

    // ── account root ─────────────────────────────────────────────────────
    match /users/{userId} {
      allow read, delete: if isOwner(userId);
      // The root document carries the profile map and timestamps only.
      allow create, update: if isOwner(userId)
        && request.resource.data.profile is map
        && validProWrite(request.resource.data.profile)
        && request.resource.data.size() <= 4;

      // ── logged workouts ────────────────────────────────────────────────
      match /sessions/{docId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && isoDate(request.resource.data.date)
          && strAtMost(request.resource.data.title, 200)
          && strAtMost(request.resource.data.categoryId, 64)
          && isIntensity(request.resource.data.intensity)
          && numBetween(request.resource.data.durationMin, 0, 100000)
          && numBetween(request.resource.data.calories, 0, 1000000)
          && numBetween(request.resource.data.createdAt, 0, 4102444800000) // ≤ 2100-01-01
          // Optional fields (distanceKm, exercises, notes, scheduleId) are
          // bounded by the field count and the per-string caps below.
          && request.resource.data.size() <= 12
          && (!('notes' in request.resource.data) || strAtMost(request.resource.data.notes, 5000))
          && (!('distanceKm' in request.resource.data) || numBetween(request.resource.data.distanceKm, 0, 100000))
          && (!('exercises' in request.resource.data) || request.resource.data.exercises is list
                && request.resource.data.exercises.size() <= 100)
          // Optional GPS trace for the walk-tracker share map.
          && (!('route' in request.resource.data) || request.resource.data.route is list
                && request.resource.data.route.size() <= 1000);
      }

      // ── recurring schedule (a slot doubles as a workout template) ──────
      match /schedule/{docId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && strAtMost(request.resource.data.title, 200)
          && strAtMost(request.resource.data.categoryId, 64)
          && strAtMost(request.resource.data.timeOfDay, 5)
          && numBetween(request.resource.data.weekday, 0, 6)
          && isIntensity(request.resource.data.intensity)
          && numBetween(request.resource.data.durationMin, 0, 100000)
          && request.resource.data.active is bool
          && request.resource.data.size() <= 10
          // Optional routine (exercise list with target sets) — bounded like
          // the one on a logged session.
          && (!('exercises' in request.resource.data) || request.resource.data.exercises is list
                && request.resource.data.exercises.size() <= 100)
          // Optional GPS trace for the walk-tracker share map.
          && (!('route' in request.resource.data) || request.resource.data.route is list
                && request.resource.data.route.size() <= 1000);
      }

      // ── goals ──────────────────────────────────────────────────────────
      match /goals/{docId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && strAtMost(request.resource.data.name, 120)
          && request.resource.data.metric in ['workouts', 'minutes', 'calories', 'distance']
          && request.resource.data.cadence in ['weekly', 'monthly']
          && numBetween(request.resource.data.target, 0, 10000000)
          && isoDate(request.resource.data.startDate)
          && request.resource.data.size() <= 8;
      }

      // ── body measurements ──────────────────────────────────────────────
      match /bodyLogs/{docId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && isoDate(request.resource.data.date)
          && strAtMost(request.resource.data.unit, 20)
          && numBetween(request.resource.data.value, 0, 10000)
          && request.resource.data.size() <= 8
          && (!('label' in request.resource.data) || strAtMost(request.resource.data.label, 60));
      }

      // ── activity categories ────────────────────────────────────────────
      match /categories/{docId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && strAtMost(request.resource.data.name, 60)
          && strAtMost(request.resource.data.icon, 40)
          && strAtMost(request.resource.data.color, 20)
          && request.resource.data.size() <= 6;
      }
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
