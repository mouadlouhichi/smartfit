rules_version = '2';

// ── SmartFit Cloud Firestore security rules ───────────────────────────────
// Every user owns exactly one document tree under users/{uid} and may only
// read/write their own data. Nothing is world-readable.
//
// Beyond ownership, writes are validated: required fields must be present
// with sane types and bounds, and documents are capped in field count and
// string length. A compromised or scripted client can therefore not use an
// account as free junk storage, and a buggy client fails loudly at the rules
// layer instead of poisoning the data it will later read back.
//
// Deploy with:  firebase deploy --only firestore:rules,firestore:indexes
service cloud.firestore {
  match /databases/{database}/documents {

    // ── helpers ──────────────────────────────────────────────────────────
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isoDate(v) {
      return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function strAtMost(v, n) {
      return v is string && v.size() <= n;
    }

    function numBetween(v, lo, hi) {
      return v is number && v >= lo && v <= hi;
    }

    function isIntensity(v) {
      return v in ['low', 'moderate', 'high'];
    }

    function isPlan(v) {
      return v in ['ppl', 'upper-lower', 'full-body', 'cardio-focus'];
    }

    // ── B2B helpers ────────────────────────────────────────────────────────
    //
    // Two layers, by design:
    //   · platform-admin  → Firebase custom claim `sfRole`. Claims are baked
    //     into the ID token and can lag, so privileged *server* routes also
    //     re-verify before acting.
    //   · gym-owner / gym-staff / member → the membership document below, read
    //     with a single get(). A claim cannot express "owner of gym A, staff at
    //     gym B", and adding staff must not wait on a token refresh.
    //
    // Rules budget only a handful of get()/exists() calls per evaluation, so
    // role resolution uses cached gym/membership document lookups, never a query.

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isPlatformAdmin() {
      return isSignedIn() && request.auth.token.get('sfRole', '') == 'platform-admin';
    }

    function membershipPath(gymId, uid) {
      return /databases/$(database)/documents/gyms/$(gymId)/members/$(uid);
    }

    function hasMembership(gymId) {
      return isSignedIn() && exists(membershipPath(gymId, request.auth.uid));
    }

    // Gym access is read from the CURRENT membership, never a tenant token claim.
    function activeGymMembership(gymId) {
      let m = get(membershipPath(gymId, request.auth.uid)).data;
      return m.status in ['active', 'trial']
        && (!('expiresAt' in m) || m.expiresAt > request.time.toMillis());
    }
    function gymRole(gymId) {
      return hasMembership(gymId) && activeGymMembership(gymId)
        && get(/databases/$(database)/documents/gyms/$(gymId)).data.status in ['active','trial','past_due']
        ? get(membershipPath(gymId, request.auth.uid)).data.role : '';
    }
    function isGymOwner(gymId) {
      return isPlatformAdmin() || (gymRole(gymId) == 'owner'
        && get(/databases/$(database)/documents/gyms/$(gymId)).data.ownerUid == request.auth.uid);
    }
    function isGymOperator(gymId) {
      return isGymOwner(gymId) || gymRole(gymId) == 'staff';
    }

    // Timestamps accepted anywhere in the tenant tree.
    function validTs(v) {
      return numBetween(v, 0, 4102444800000); // ≤ 2100-01-01
    }

    function isGymStatus(v) {
      return v in ['pending', 'trial', 'active', 'past_due', 'suspended', 'closed'];
    }

    function isMembershipStatus(v) {
      return v in ['trial', 'active', 'frozen', 'expired', 'cancelled'];
    }

    function isBookingStatus(v) {
      return v in ['booked', 'attended', 'no_show', 'cancelled', 'waitlist'];
    }

    // A gym document id *is* its slug, which is what makes subdomains unique
    // for free — Firestore will not create a second document with the same id.
    function slugMatchesId(gymId) {
      return gymId == request.resource.data.slug
        && gymId.matches('^[a-z0-9][a-z0-9-]{0,46}[a-z0-9]$');
    }

    function brandImageUrl(v) {
      return strAtMost(v, 2048) && (v == '' || v.matches('https://[^/@?#]+([/?#].*)?'));
    }
    function validGymBranding(b) {
      return b is map && b.keys().hasOnly(['logoUrl','coverUrl','accentColor','tagline','description','logoData','logoShape','heroLayout','coverPreset','coverPosition','ctaLabel','amenities','galleryUrls'])
        && (!('logoUrl' in b) || brandImageUrl(b.logoUrl))
        && (!('coverUrl' in b) || brandImageUrl(b.coverUrl))
        && (!('accentColor' in b) || b.accentColor.matches('#[0-9a-fA-F]{6}'))
        && (!('tagline' in b) || strAtMost(b.tagline,160))
        && (!('description' in b) || strAtMost(b.description,2000))
        && (!('logoData' in b) || strAtMost(b.logoData,32768) && (b.logoData == '' || b.logoData.matches('data:image/(png|jpeg|webp);base64,[A-Za-z0-9+/]+={0,2}')))
        && (!('logoShape' in b) || b.logoShape in ['rounded','circle','square'])
        && (!('heroLayout' in b) || b.heroLayout in ['split','banner','minimal'])
        && (!('coverPreset' in b) || b.coverPreset in ['strength','studio','combat','recovery'])
        && (!('coverPosition' in b) || b.coverPosition in ['top','center','bottom'])
        && (!('ctaLabel' in b) || strAtMost(b.ctaLabel,32))
        && (!('amenities' in b) || b.amenities is list && b.amenities.size() <= 8 && b.amenities.hasOnly(['Showers','Lockers','Parking','Personal training','Group classes','Accessible entrance','Wi-Fi','Recovery area']))
        && (!('galleryUrls' in b) || b.galleryUrls is list && b.galleryUrls.size() <= 3
          && (b.galleryUrls.size() < 1 || brandImageUrl(b.galleryUrls[0]))
          && (b.galleryUrls.size() < 2 || brandImageUrl(b.galleryUrls[1]))
          && (b.galleryUrls.size() < 3 || brandImageUrl(b.galleryUrls[2])));
    }

    function validGymDoc(gymId) {
      let d = request.resource.data;
      return slugMatchesId(gymId)
        && strAtMost(d.name, 100)
        && isGymStatus(d.status)
        && strAtMost(d.tenantPlanId, 40)
        && strAtMost(d.ownerUid, 128)
        && validTs(d.createdAt)
        && d.size() <= 14
        && (!('subdomain' in d) || strAtMost(d.subdomain, 48))
        && (!('branding' in d) || validGymBranding(d.branding))
        && (!('contact' in d) || d.contact is map
              && d.contact.size() <= 5)
        && (!('location' in d) || d.location is map
              && d.location.size() <= 5)
        && (!('hours' in d) || d.hours is map
              && d.hours.size() <= 7);
    }

    function validMembership() {
      return request.resource.data.role in ['owner', 'staff', 'trainer', 'member']
        && isMembershipStatus(request.resource.data.status)
        && validTs(request.resource.data.joinedAt)
        && numBetween(request.resource.data.checkins, 0, 10000000)
        && request.resource.data.size() <= 14
        && (!('expiresAt' in request.resource.data) || validTs(request.resource.data.expiresAt))
        && (!('lastVisitAt' in request.resource.data) || validTs(request.resource.data.lastVisitAt))
        && (!('notes' in request.resource.data) || strAtMost(request.resource.data.notes, 2000))
        && (!('displayName' in request.resource.data) || strAtMost(request.resource.data.displayName, 80))
        && (!('email' in request.resource.data) || strAtMost(request.resource.data.email, 254))
        && (!('phone' in request.resource.data) || strAtMost(request.resource.data.phone, 40))
        && (!('planId' in request.resource.data) || strAtMost(request.resource.data.planId, 64));
    }

    function validClass() {
      return strAtMost(request.resource.data.name, 120)
        && request.resource.data.focus in ['cardio', 'hiit', 'strength', 'combat', 'mind', 'aqua']
        && isIntensity(request.resource.data.intensity)
        && numBetween(request.resource.data.minutes, 1, 600)
        && numBetween(request.resource.data.capacity, 0, 1000)
        && validTs(request.resource.data.createdAt)
        && request.resource.data.size() <= 12
        && (!('instructorUid' in request.resource.data) || strAtMost(request.resource.data.instructorUid, 128))
        && (!('instructorName' in request.resource.data) || strAtMost(request.resource.data.instructorName, 80))
        && (!('studio' in request.resource.data) || strAtMost(request.resource.data.studio, 80))
        && (!('description' in request.resource.data) || strAtMost(request.resource.data.description, 1000));
    }

    function validSlot() {
      return strAtMost(request.resource.data.classId, 128)
        && validTs(request.resource.data.startsAt)
        && validTs(request.resource.data.endsAt)
        && request.resource.data.endsAt > request.resource.data.startsAt
        && numBetween(request.resource.data.capacity, 0, 1000)
        && numBetween(request.resource.data.booked, 0, 1000)
        && request.resource.data.size() <= 10
        && (!('cancelled' in request.resource.data) || request.resource.data.cancelled is bool);
    }

    function validBooking() {
      return strAtMost(request.resource.data.slotId, 128)
        && strAtMost(request.resource.data.uid, 128)
        && isBookingStatus(request.resource.data.status)
        && validTs(request.resource.data.createdAt)
        && request.resource.data.size() <= 10
        && (!('memberName' in request.resource.data) || strAtMost(request.resource.data.memberName, 80))
        && (!('markedBy' in request.resource.data) || strAtMost(request.resource.data.markedBy, 128))
        && (!('markedAt' in request.resource.data) || validTs(request.resource.data.markedAt));
    }

    // A door visit. Written by the front desk alongside the roster counter.
    function validCheckin() {
      return strAtMost(request.resource.data.uid, 128)
        && validTs(request.resource.data.at)
        && request.resource.data.size() <= 5
        && (!('by' in request.resource.data) || strAtMost(request.resource.data.by, 128))
        && (!('slotId' in request.resource.data) || strAtMost(request.resource.data.slotId, 128));
    }

    function validMembershipPlan() {
      return strAtMost(request.resource.data.name, 80)
        && numBetween(request.resource.data.priceMinor, 0, 100000000)
        && request.resource.data.currency.matches('^[A-Z]{3}$')
        && request.resource.data.period in ['month', 'quarter', 'year', 'pass']
        && request.resource.data.size() <= 10
        && (!('joinFeeMinor' in request.resource.data) || numBetween(request.resource.data.joinFeeMinor, 0, 100000000))
        && (!('published' in request.resource.data) || request.resource.data.published is bool)
        && (!('description' in request.resource.data) || strAtMost(request.resource.data.description, 500));
    }

    function validInvoice() {
      return strAtMost(request.resource.data.memberUid, 128)
        && numBetween(request.resource.data.amountMinor, 0, 100000000)
        && request.resource.data.currency.matches('^[A-Z]{3}$')
        && request.resource.data.status in ['draft', 'paid', 'refunded', 'void', 'overdue']
        && validTs(request.resource.data.issuedAt)
        && request.resource.data.size() <= 12
        && (!('method' in request.resource.data) || request.resource.data.method in ['cash', 'card', 'transfer', 'cmi', 'stripe', 'other'])
        && (!('paidAt' in request.resource.data) || validTs(request.resource.data.paidAt))
        && (!('issuedBy' in request.resource.data) || strAtMost(request.resource.data.issuedBy, 128))
        && (!('planId' in request.resource.data) || strAtMost(request.resource.data.planId, 64))
        && (!('note' in request.resource.data) || strAtMost(request.resource.data.note, 500));
    }

    function validAuditEntry() {
      return strAtMost(request.resource.data.actorUid, 128)
        && strAtMost(request.resource.data.action, 80)
        && validTs(request.resource.data.at)
        && request.resource.data.size() <= 6
        && (!('target' in request.resource.data) || strAtMost(request.resource.data.target, 200))
        && (!('meta' in request.resource.data) || request.resource.data.meta is map
              && request.resource.data.meta.size() <= 10);
    }

    // Pro is local-preview state until a trusted Admin SDK billing backend
    // exists. A browser may not create either a trial or a paid stamp in
    // Firestore. An already provisioned paid stamp may be carried through an
    // ordinary profile edit only when it is byte-for-byte unchanged.
    function validPro(profile) {
      return !('pro' in profile);
    }

    function isPaidPlan(profile) {
      return profile is map
        && ('pro' in profile)
        && profile.pro is map
        && profile.pro.plan in ['monthly', 'yearly', 'lifetime']
        && profile.pro.since is number
        && profile.pro.since > 0
        && profile.pro.size() <= 3;
    }

    function keepsServerProStamp(profile) {
      return isPaidPlan(resource.data.profile)
        && isPaidPlan(profile)
        && profile.pro == resource.data.profile.pro;
    }

    function validProWrite(profile) {
      return validPro(profile) || keepsServerProStamp(profile);
    }

    function validTrainingPreferences(p) {
      return p is map && p.size() == 10 && p.schemaVersion == 1
        && p.goal in ['strength', 'muscle', 'fitness']
        && p.experience in ['beginner', 'intermediate', 'advanced']
        && p.location in ['home', 'gym', 'outdoors']
        && p.days is list && p.days.size() > 0 && p.days.size() <= 6
        && p.days.hasOnly([0, 1, 2, 3, 4, 5, 6])
        && p.minutes in [15, 20, 30, 45, 60]
        && p.equipment is list && p.equipment.size() > 0 && p.equipment.size() <= 2
        && p.equipment.hasOnly(['bodyweight', 'dumbbells'])
        && p.constraints is list && p.constraints.size() <= 2
        && p.constraints.hasOnly(['no-floor', 'no-overhead'])
        && p.excludedExercises is list && p.excludedExercises.size() <= 30
        && p.excludedExercises.hasOnly(['bodyweight-squat', 'wall-pushup', 'standing-calf-raise', 'glute-bridge', 'dumbbell-curl', 'dumbbell-press'])
        && p.needsClearance is bool;
    }

    function validProfile(profile) {
      return profile is map
        && profile.size() <= 16
        && (!('name' in profile) || strAtMost(profile.name, 80))
        && (!('weightUnit' in profile) || profile.weightUnit in ['kg', 'lb'])
        && (!('distanceUnit' in profile) || profile.distanceUnit in ['km', 'mi'])
        && (!('weeklyRestDays' in profile) || numBetween(profile.weeklyRestDays, 0, 6))
        && (!('weekStartsOn' in profile) || profile.weekStartsOn in [0, 1])
        && (!('planId' in profile) || isPlan(profile.planId))
        && (!('onboardingDone' in profile) || profile.onboardingDone is bool)
        && (!('targetWeightKg' in profile) || numBetween(profile.targetWeightKg, 20, 400))
        && (!('gymId' in profile) || strAtMost(profile.gymId, 64))
        && (!('nutritionGoal' in profile) || profile.nutritionGoal in ['cut', 'maintain', 'gain'])
        && (!('activityLevel' in profile)
              || profile.activityLevel in ['sedentary', 'light', 'moderate', 'active'])
        && (!('sex' in profile) || profile.sex in ['female', 'male'])
        && (!('ageYears' in profile) || numBetween(profile.ageYears, 10, 100))
        && (!('heightCm' in profile) || numBetween(profile.heightCm, 100, 250))
        && (!('trainingPreferences' in profile) || validTrainingPreferences(profile.trainingPreferences))
        && validProWrite(profile);
    }

    // ── account root ─────────────────────────────────────────────────────
    match /users/{userId} {
      allow read, delete: if isOwner(userId);
      // The root document carries the profile map and timestamps only.
      allow create, update: if isOwner(userId)
        && validProfile(request.resource.data.profile)
        && request.resource.data.size() <= 4;

      // ── logged workouts ────────────────────────────────────────────────
      match /sessions/{docId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && isoDate(request.resource.data.date)
          && strAtMost(request.resource.data.title, 200)
          && strAtMost(request.resource.data.categoryId, 64)
          && isIntensity(request.resource.data.intensity)
          && numBetween(request.resource.data.durationMin, 0, 100000)
          && numBetween(request.resource.data.calories, 0, 1000000)
          && numBetween(request.resource.data.createdAt, 0, 4102444800000) // ≤ 2100-01-01
          // Optional run/session fields can coexist (route + splits + moving
          // time are all emitted by the GPS recorder), so the cap leaves room
          // for the complete canonical WorkoutSession without permitting an
          // arbitrary document.
          && request.resource.data.size() <= 18
          && (!('notes' in request.resource.data) || strAtMost(request.resource.data.notes, 5000))
          && (!('distanceKm' in request.resource.data) || numBetween(request.resource.data.distanceKm, 0, 100000))
          && (!('scheduleId' in request.resource.data) || strAtMost(request.resource.data.scheduleId, 128))
          && (!('movingTimeMin' in request.resource.data) || numBetween(request.resource.data.movingTimeMin, 0, 100000))
          && (!('elevationGainM' in request.resource.data) || numBetween(request.resource.data.elevationGainM, 0, 1000000))
          && (!('exercises' in request.resource.data) || request.resource.data.exercises is list
                && request.resource.data.exercises.size() <= 100)
          && (!('splits' in request.resource.data) || request.resource.data.splits is list
                && request.resource.data.splits.size() <= 200)
          // Optional GPS trace for the walk-tracker share map.
          && (!('route' in request.resource.data) || request.resource.data.route is list
                && request.resource.data.route.size() <= 1000);
      }

      // ── recurring schedule (a slot doubles as a workout template) ──────
      match /schedule/{docId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && strAtMost(request.resource.data.title, 200)
          && strAtMost(request.resource.data.categoryId, 64)
          && request.resource.data.timeOfDay.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
          && numBetween(request.resource.data.weekday, 0, 6)
          && isIntensity(request.resource.data.intensity)
          && numBetween(request.resource.data.durationMin, 0, 100000)
          && numBetween(request.resource.data.createdAt, 0, 4102444800000)
          && request.resource.data.active is bool
          && request.resource.data.size() <= 10
          // Optional routine (exercise list with target sets) — bounded like
          // the one on a logged session.
          && (!('exercises' in request.resource.data) || request.resource.data.exercises is list
                && request.resource.data.exercises.size() <= 100)
          // Optional GPS trace for the walk-tracker share map.
          && (!('route' in request.resource.data) || request.resource.data.route is list
                && request.resource.data.route.size() <= 1000);
      }

      // ── goals ──────────────────────────────────────────────────────────
      match /goals/{docId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && strAtMost(request.resource.data.name, 120)
          && request.resource.data.metric in ['workouts', 'minutes', 'calories', 'distance']
          && request.resource.data.cadence in ['weekly', 'monthly']
          && numBetween(request.resource.data.target, 0, 10000000)
          && isoDate(request.resource.data.startDate)
          && numBetween(request.resource.data.createdAt, 0, 4102444800000)
          && request.resource.data.size() <= 8;
      }

      // ── body measurements ──────────────────────────────────────────────
      match /bodyLogs/{docId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && isoDate(request.resource.data.date)
          && request.resource.data.unit in ['weight', 'bodyfat', 'waist', 'chest', 'arms', 'custom']
          && numBetween(request.resource.data.value, 0, 10000)
          && numBetween(request.resource.data.createdAt, 0, 4102444800000)
          && request.resource.data.size() <= 8
          && (!('label' in request.resource.data) || strAtMost(request.resource.data.label, 60));
      }

      // ── meal / nutrition logs ──────────────────────────────────────────
      match /meals/{docId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && isoDate(request.resource.data.date)
          && strAtMost(request.resource.data.name, 120)
          && request.resource.data.slot in ['breakfast', 'lunch', 'dinner', 'snack']
          && numBetween(request.resource.data.calories, 0, 100000)
          && numBetween(request.resource.data.protein, 0, 10000)
          && numBetween(request.resource.data.createdAt, 0, 4102444800000)
          && request.resource.data.size() <= 9
          && (!('carbs' in request.resource.data) || numBetween(request.resource.data.carbs, 0, 10000))
          && (!('fat' in request.resource.data) || numBetween(request.resource.data.fat, 0, 10000))
          && (!('scanned' in request.resource.data) || request.resource.data.scanned is bool);
      }

      // ── activity categories ────────────────────────────────────────────
      match /categories/{docId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && strAtMost(request.resource.data.name, 60)
          && strAtMost(request.resource.data.icon, 40)
          && strAtMost(request.resource.data.color, 20)
          && (!('builtin' in request.resource.data) || request.resource.data.builtin is bool)
          && request.resource.data.size() <= 6;
      }

      // ── opt-in progress sharing with a gym ─────────────────────────────
      // The privacy boundary of the whole B2B pivot, and the reason the
      // `users/{userId}` tree above stays owner-only.
      //
      // The *member* writes this document into their own tree; the gym only
      // reads it. So a gym never touches `users/{uid}/sessions`, never sees
      // body measurements, and loses access the moment the member deletes the
      // document. Aggregates only — the field allowlist below is what makes
      // "aggregates only" enforceable rather than aspirational.
      match /gymShares/{gymId} {
        allow read: if isOwner(userId) || isGymOperator(gymId);
        allow create, update: if isOwner(userId)
          // The document id must name the gym it is shared with, so a client
          // cannot file a share under a gym that never asked for it.
          && request.resource.data.gymId == gymId
          && numBetween(request.resource.data.sessionsThisMonth, 0, 100000)
          && numBetween(request.resource.data.streakDays, 0, 36500)
          && numBetween(request.resource.data.attendancePct, 0, 100)
          && validTs(request.resource.data.sharedAt)
          && request.resource.data.size() <= 5;
        // Revoking is the whole mechanism — there is nothing to sync.
        allow delete: if isOwner(userId);
      }

      // ── custom gyms (user-created) ─────────────────────────────────────
      match /customGyms/{docId} {        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && strAtMost(request.resource.data.name, 100)
          && request.resource.data.custom == true
          && numBetween(request.resource.data.createdAt, 0, 4102444800000)
          && request.resource.data.size() <= 20
          && (!('location' in request.resource.data) || strAtMost(request.resource.data.location, 200))
          && (!('hours' in request.resource.data) || strAtMost(request.resource.data.hours, 200))
          && (!('description' in request.resource.data) || strAtMost(request.resource.data.description, 1000))
          && (!('programs' in request.resource.data) || request.resource.data.programs is list
                && request.resource.data.programs.size() <= 50);
      }
    }

    // ── B2B tenants ────────────────────────────────────────────────────────
    //
    // A gym is a top-level document whose **id is its slug**, so subdomain
    // uniqueness is enforced by Firestore itself. The trade-off is that a slug
    // is immutable once issued — the display `name` is freely editable, and a
    // genuine rebrand is a platform-admin migration. That is the right side of
    // the trade: a subdomain is marketing, and a gym's members bookmark it.
    //
    // The public storefront (`gyms/{gymId}`) is readable by any signed-in user
    // because that is what a storefront is. Anything sensitive therefore lives
    // in `settings/` — read grants in Firestore are per-document, never
    // per-field, so splitting the document is the only way to publish part of
    // a tenant safely.
    match /gyms/{gymId} {
      allow read: if isSignedIn();
      // Provisioning allocates a subdomain and creates the owner membership, so it is
      // a platform act (see `gym:create`). An owner cannot self-provision.
      allow create: if isPlatformAdmin() && validGymDoc(gymId);
      // An owner edits their own gym but may not change lifecycle status or
      // transfer ownership — those are `gym:suspend` / `gym:restore` and a
      // platform-admin action respectively.
      // Validate once: evaluating the full branding map in both branches can
      // exceed Firestore's 1000-expression budget for a legitimate owner update.
      allow update: if validGymDoc(gymId)
        && (isPlatformAdmin() || (isGymOwner(gymId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','branding','contact','location','hours','updatedAt'])));
      // Closing a gym destroys its members' bookings and history. Platform only;
      // an owner asks support. `gym:delete` in the matrix is the UI affordance.
      allow delete: if isPlatformAdmin();

      // ── roster + per-gym role resolution ───────────────────────────────
      // This collection is what every rule above get()s, so it must stay a
      // single-document read with no query.
      match /members/{memberUid} {
        allow read: if isGymOperator(gymId) || isSelf(memberUid);
        // All privileged role changes go through the audited server transaction.
        allow create: if validMembership()
          && (!('uid' in request.resource.data) || request.resource.data.uid == memberUid) && request.resource.data.role == 'member'
          && !request.resource.data.keys().hasAny(['roleChangedAt','roleChangedBy'])
          && (isGymOperator(gymId) || isSelf(memberUid) && request.resource.data.checkins == 0);
        allow update: if isGymOperator(gymId) && validMembership()
          && (!('uid' in request.resource.data) || request.resource.data.uid == memberUid)
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role','roleChangedAt','roleChangedBy'])
          && (isGymOwner(gymId) || resource.data.role == 'member')
          // Never let a direct client update disable the authoritative owner.
          && (memberUid != get(/databases/$(database)/documents/gyms/$(gymId)).data.ownerUid
            || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status','expiresAt']));
        // Leaving a plain membership is self-service. Remove team access first.
        allow delete: if resource.data.role == 'member'
          && memberUid != get(/databases/$(database)/documents/gyms/$(gymId)).data.ownerUid
          && (isGymOwner(gymId) || isSelf(memberUid));
      }

      // ── class templates ────────────────────────────────────────────────
      match /classes/{classId} {
        allow read: if isSignedIn();
        allow create, update: if isGymOperator(gymId) && validClass();
        allow delete: if isGymOwner(gymId);
      }

      // ── class occurrences ──────────────────────────────────────────────
      // Capacity is *not* enforceable here — that needs a query. The booking
      // flow runs a transaction against slots/{slotId} and increments `booked`
      // only while there is room; these rules enforce shape and authorisation.
      match /slots/{slotId} {
        allow read: if isSignedIn();
        allow create, update: if isGymOperator(gymId) && validSlot();
        allow delete: if isGymOwner(gymId);
      }

      // ── bookings ───────────────────────────────────────────────────────
      match /bookings/{bookingId} {
        allow read: if isGymOperator(gymId)
          || (isSignedIn() && resource.data.uid == request.auth.uid);
        // A member books or cancels their own seat; staff book for anyone.
        allow create: if isGymOperator(gymId) && validBooking()
          || isSignedIn() && validBooking()
               && request.resource.data.uid == request.auth.uid
               && request.resource.data.status in ['booked', 'waitlist'];
        // Attendance marks are staff-only; a member may only cancel.
        allow update: if isGymOperator(gymId) && validBooking()
          || (isSignedIn() && resource.data.uid == request.auth.uid
               && request.resource.data.status == 'cancelled'
               && validBooking());
        allow delete: if isGymOwner(gymId);
      }

      // ── door visits ──────────────────────────────────────────────────────
      // The membership row keeps a counter for the console's metrics; this
      // collection is the visit-by-visit history a member sees. Visits are
      // recorded by staff (a member must not be able to forge attendance) and
      // are append-only — rewriting history is not a front-desk operation.
      match /checkins/{visitId} {
        allow read: if isGymOperator(gymId)
          || (isSignedIn() && resource.data.uid == request.auth.uid);
        allow create: if isGymOperator(gymId) && validCheckin();
        allow update, delete: if false;
      }

      // ── membership tiers & pricing ─────────────────────────────────────
      match /plans/{planId} {
        allow read: if isSignedIn();
        allow create, update, delete: if isGymOwner(gymId) && validMembershipPlan();
      }

      // ── money ──────────────────────────────────────────────────────────
      match /invoices/{invoiceId} {
        // A member may read their own invoice; nobody reads anyone else's.
        allow read: if isGymOperator(gymId)
          || (isSignedIn() && resource.data.memberUid == request.auth.uid);
        // Front desk issues and takes payment; refunds are owner-only.
        allow create, update: if isGymOperator(gymId) && validInvoice();
        allow delete: if isGymOwner(gymId);
      }

      // ── operations ─────────────────────────────────────────────────────
      match /broadcasts/{broadcastId} {
        allow read: if isGymOperator(gymId) || isSignedIn();
        allow create, update: if isGymOperator(gymId)
          && strAtMost(request.resource.data.subject, 160)
          && strAtMost(request.resource.data.body, 4000)
          && validTs(request.resource.data.sentAt)
          && request.resource.data.size() <= 8;
        allow delete: if isGymOwner(gymId);
      }

      match /equipment/{equipmentId} {
        allow read: if isGymOperator(gymId);
        allow create, update: if isGymOperator(gymId)
          && strAtMost(request.resource.data.name, 120)
          && request.resource.data.status in ['ok', 'faulty', 'repairing', 'retired']
          && request.resource.data.size() <= 8
          && (!('note' in request.resource.data) || strAtMost(request.resource.data.note, 1000))
          && (!('nextServiceAt' in request.resource.data) || validTs(request.resource.data.nextServiceAt));
        allow delete: if isGymOwner(gymId);
      }

      match /shifts/{shiftId} {
        allow read: if isGymOperator(gymId)
          || (isSignedIn() && resource.data.staffUid == request.auth.uid);
        allow create, update, delete: if isGymOperator(gymId)
          && strAtMost(request.resource.data.staffUid, 128)
          && validTs(request.resource.data.startsAt)
          && validTs(request.resource.data.endsAt)
          && request.resource.data.endsAt > request.resource.data.startsAt
          && request.resource.data.size() <= 8;
      }

      // ── private tenant settings ────────────────────────────────────────
      // Deliberately NOT readable by ordinary members: timezone, tax, waiver
      // text and feature flags are business configuration. Owner-only rather
      // than staff too — tax sits next to revenue, and `revenue:read` is an
      // owner capability, so the whole document follows it.
      match /settings/{settingsId} {
        allow read: if isGymOwner(gymId);
        allow create, update: if isGymOwner(gymId)
          && request.resource.data.size() <= 20
          && (!('timezone' in request.resource.data) || strAtMost(request.resource.data.timezone, 60))
          && (!('currency' in request.resource.data) || request.resource.data.currency.matches('^[A-Z]{3}$'))
          && (!('taxPct' in request.resource.data) || numBetween(request.resource.data.taxPct, 0, 100))
          && (!('waiverText' in request.resource.data) || strAtMost(request.resource.data.waiverText, 5000))
          && (!('noShowPolicy' in request.resource.data) || strAtMost(request.resource.data.noShowPolicy, 1000))
          && (!('flags' in request.resource.data) || request.resource.data.flags is map
                && request.resource.data.flags.size() <= 20);
        allow delete: if isPlatformAdmin();
      }

      // ── audit trail ────────────────────────────────────────────────────
      // Append-only. A log the subject can edit or delete is not a log.
      match /audit/{entryId} {
        allow read: if isGymOwner(gymId);
        allow create: if isGymOperator(gymId) && validAuditEntry()
          && request.resource.data.actorUid == request.auth.uid
          && request.resource.data.action != 'staff:role:change';
        allow update, delete: if false;
      }
    }

    // ── platform namespace ───────────────────────────────────────────────
    // Admin SDK only. Cross-tenant configuration, the application queue and
    // the platform-wide audit trail must never be reachable from a browser.
    match /platform/{document=**} {
      allow read, write: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
