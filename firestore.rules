rules_version = '2';

// ── SmartFit Cloud Firestore security rules ───────────────────────────────
// Every user owns exactly one document tree under users/{uid} and may only
// read/write their own data. Nothing is world-readable.
//
// Beyond ownership, writes are validated: required fields must be present
// with sane types and bounds, and documents are capped in field count and
// string length. A compromised or scripted client can therefore not use an
// account as free junk storage, and a buggy client fails loudly at the rules
// layer instead of poisoning the data it will later read back.
//
// Deploy with:  firebase deploy --only firestore:rules,firestore:indexes
service cloud.firestore {
  match /databases/{database}/documents {

    // ── helpers ──────────────────────────────────────────────────────────
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isoDate(v) {
      return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function strAtMost(v, n) {
      return v is string && v.size() <= n;
    }

    function numBetween(v, lo, hi) {
      return v is number && v >= lo && v <= hi;
    }

    function isIntensity(v) {
      return v in ['low', 'moderate', 'high'];
    }

    function isPlan(v) {
      return v in ['ppl', 'upper-lower', 'full-body', 'cardio-focus'];
    }

    // Pro is local-preview state until a trusted Admin SDK billing backend
    // exists. A browser may not create either a trial or a paid stamp in
    // Firestore. An already provisioned paid stamp may be carried through an
    // ordinary profile edit only when it is byte-for-byte unchanged.
    function validPro(profile) {
      return !('pro' in profile);
    }

    function isPaidPlan(profile) {
      return profile is map
        && ('pro' in profile)
        && profile.pro is map
        && profile.pro.plan in ['monthly', 'yearly', 'lifetime']
        && profile.pro.since is number
        && profile.pro.since > 0
        && profile.pro.size() <= 3;
    }

    function keepsServerProStamp(profile) {
      return isPaidPlan(resource.data.profile)
        && isPaidPlan(profile)
        && profile.pro == resource.data.profile.pro;
    }

    function validProWrite(profile) {
      return validPro(profile) || keepsServerProStamp(profile);
    }

    function validProfile(profile) {
      return profile is map
        && profile.size() <= 15
        && (!('name' in profile) || strAtMost(profile.name, 80))
        && (!('weightUnit' in profile) || profile.weightUnit in ['kg', 'lb'])
        && (!('distanceUnit' in profile) || profile.distanceUnit in ['km', 'mi'])
        && (!('weeklyRestDays' in profile) || numBetween(profile.weeklyRestDays, 0, 6))
        && (!('weekStartsOn' in profile) || profile.weekStartsOn in [0, 1])
        && (!('planId' in profile) || isPlan(profile.planId))
        && (!('onboardingDone' in profile) || profile.onboardingDone is bool)
        && (!('targetWeightKg' in profile) || numBetween(profile.targetWeightKg, 20, 400))
        && (!('gymId' in profile) || strAtMost(profile.gymId, 64))
        && (!('nutritionGoal' in profile) || profile.nutritionGoal in ['cut', 'maintain', 'gain'])
        && (!('activityLevel' in profile)
              || profile.activityLevel in ['sedentary', 'light', 'moderate', 'active'])
        && (!('sex' in profile) || profile.sex in ['female', 'male'])
        && (!('ageYears' in profile) || numBetween(profile.ageYears, 10, 100))
        && (!('heightCm' in profile) || numBetween(profile.heightCm, 100, 250))
        && validProWrite(profile);
    }

    // ── account root ─────────────────────────────────────────────────────
    match /users/{userId} {
      allow read, delete: if isOwner(userId);
      // The root document carries the profile map and timestamps only.
      allow create, update: if isOwner(userId)
        && validProfile(request.resource.data.profile)
        && request.resource.data.size() <= 4;

      // ── logged workouts ────────────────────────────────────────────────
      match /sessions/{docId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && isoDate(request.resource.data.date)
          && strAtMost(request.resource.data.title, 200)
          && strAtMost(request.resource.data.categoryId, 64)
          && isIntensity(request.resource.data.intensity)
          && numBetween(request.resource.data.durationMin, 0, 100000)
          && numBetween(request.resource.data.calories, 0, 1000000)
          && numBetween(request.resource.data.createdAt, 0, 4102444800000) // ≤ 2100-01-01
          // Optional run/session fields can coexist (route + splits + moving
          // time are all emitted by the GPS recorder), so the cap leaves room
          // for the complete canonical WorkoutSession without permitting an
          // arbitrary document.
          && request.resource.data.size() <= 18
          && (!('notes' in request.resource.data) || strAtMost(request.resource.data.notes, 5000))
          && (!('distanceKm' in request.resource.data) || numBetween(request.resource.data.distanceKm, 0, 100000))
          && (!('scheduleId' in request.resource.data) || strAtMost(request.resource.data.scheduleId, 128))
          && (!('movingTimeMin' in request.resource.data) || numBetween(request.resource.data.movingTimeMin, 0, 100000))
          && (!('elevationGainM' in request.resource.data) || numBetween(request.resource.data.elevationGainM, 0, 1000000))
          && (!('exercises' in request.resource.data) || request.resource.data.exercises is list
                && request.resource.data.exercises.size() <= 100)
          && (!('splits' in request.resource.data) || request.resource.data.splits is list
                && request.resource.data.splits.size() <= 200)
          // Optional GPS trace for the walk-tracker share map.
          && (!('route' in request.resource.data) || request.resource.data.route is list
                && request.resource.data.route.size() <= 1000);
      }

      // ── recurring schedule (a slot doubles as a workout template) ──────
      match /schedule/{docId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && strAtMost(request.resource.data.title, 200)
          && strAtMost(request.resource.data.categoryId, 64)
          && request.resource.data.timeOfDay.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
          && numBetween(request.resource.data.weekday, 0, 6)
          && isIntensity(request.resource.data.intensity)
          && numBetween(request.resource.data.durationMin, 0, 100000)
          && numBetween(request.resource.data.createdAt, 0, 4102444800000)
          && request.resource.data.active is bool
          && request.resource.data.size() <= 10
          // Optional routine (exercise list with target sets) — bounded like
          // the one on a logged session.
          && (!('exercises' in request.resource.data) || request.resource.data.exercises is list
                && request.resource.data.exercises.size() <= 100)
          // Optional GPS trace for the walk-tracker share map.
          && (!('route' in request.resource.data) || request.resource.data.route is list
                && request.resource.data.route.size() <= 1000);
      }

      // ── goals ──────────────────────────────────────────────────────────
      match /goals/{docId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && strAtMost(request.resource.data.name, 120)
          && request.resource.data.metric in ['workouts', 'minutes', 'calories', 'distance']
          && request.resource.data.cadence in ['weekly', 'monthly']
          && numBetween(request.resource.data.target, 0, 10000000)
          && isoDate(request.resource.data.startDate)
          && numBetween(request.resource.data.createdAt, 0, 4102444800000)
          && request.resource.data.size() <= 8;
      }

      // ── body measurements ──────────────────────────────────────────────
      match /bodyLogs/{docId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && isoDate(request.resource.data.date)
          && request.resource.data.unit in ['weight', 'bodyfat', 'waist', 'chest', 'arms', 'custom']
          && numBetween(request.resource.data.value, 0, 10000)
          && numBetween(request.resource.data.createdAt, 0, 4102444800000)
          && request.resource.data.size() <= 8
          && (!('label' in request.resource.data) || strAtMost(request.resource.data.label, 60));
      }

      // ── meal / nutrition logs ──────────────────────────────────────────
      match /meals/{docId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && isoDate(request.resource.data.date)
          && strAtMost(request.resource.data.name, 120)
          && request.resource.data.slot in ['breakfast', 'lunch', 'dinner', 'snack']
          && numBetween(request.resource.data.calories, 0, 100000)
          && numBetween(request.resource.data.protein, 0, 10000)
          && numBetween(request.resource.data.createdAt, 0, 4102444800000)
          && request.resource.data.size() <= 9
          && (!('carbs' in request.resource.data) || numBetween(request.resource.data.carbs, 0, 10000))
          && (!('fat' in request.resource.data) || numBetween(request.resource.data.fat, 0, 10000))
          && (!('scanned' in request.resource.data) || request.resource.data.scanned is bool);
      }

      // ── activity categories ────────────────────────────────────────────
      match /categories/{docId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && strAtMost(request.resource.data.name, 60)
          && strAtMost(request.resource.data.icon, 40)
          && strAtMost(request.resource.data.color, 20)
          && (!('builtin' in request.resource.data) || request.resource.data.builtin is bool)
          && request.resource.data.size() <= 6;
      }

      // ── custom gyms (user-created) ─────────────────────────────────────
      match /customGyms/{docId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && strAtMost(request.resource.data.name, 100)
          && request.resource.data.custom == true
          && numBetween(request.resource.data.createdAt, 0, 4102444800000)
          && request.resource.data.size() <= 20
          && (!('location' in request.resource.data) || strAtMost(request.resource.data.location, 200))
          && (!('hours' in request.resource.data) || strAtMost(request.resource.data.hours, 200))
          && (!('description' in request.resource.data) || strAtMost(request.resource.data.description, 1000))
          && (!('programs' in request.resource.data) || request.resource.data.programs is list
                && request.resource.data.programs.size() <= 50);
      }
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
