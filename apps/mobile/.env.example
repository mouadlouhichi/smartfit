# ── SmartFit mobile (@smartfit/mobile) ───────────────────────────────────
# Expo inlines EXPO_PUBLIC_* vars at build/start time. Every one of them is
# OPTIONAL — with none set the app runs local-first (AsyncStorage) with no
# backend at all, which is the default and the recommended way to start.
#
# Copy to `apps/mobile/.env` and fill in what you need.

# Default training strategy: ppl | upper-lower | full-body | cardio-focus
EXPO_PUBLIC_DEFAULT_PLAN=full-body

# App display name.
EXPO_PUBLIC_APP_NAME=SmartFit

# ── Cloud mode (optional) ────────────────────────────────────────────────
# Fill in all four REQUIREMENTS — api key, auth domain, project id, app id —
# to switch the app into cloud mode: the sign-in / sign-up / password-reset
# screens appear and accounts are shared with the web deployment. Anything
# missing (or blank) keeps the app local-only.
#
# Use the SAME Firebase project as the web app so one account works on both.
# These are client identifiers, not secrets; access is governed by Firestore
# security rules. See the "Mobile manual steps" section of README.md.
#
# EXPO_PUBLIC_FIREBASE_API_KEY=
# EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
# EXPO_PUBLIC_FIREBASE_PROJECT_ID=
# EXPO_PUBLIC_FIREBASE_APP_ID=
#
# Optional extras — only needed if you enable Storage or FCM later.
# EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
# EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# ── Google sign-in (optional) ────────────────────────────────────────────
# The OAuth 2.0 client ids from Firebase console → Authentication → Sign-in
# method → Google → Web SDK configuration (the WEB id is also the default
# fallback for the other platforms). Native sign-in needs one client per
# platform you ship, created from each platform's registered package name /
# bundle id plus its signing certificate SHA-1 (Android) — see README.md.
# Redirect URI scheme: smartfit
#
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# ── Other reserved server settings ───────────────────────────────────────
# EXPO_PUBLIC_API_URL=
