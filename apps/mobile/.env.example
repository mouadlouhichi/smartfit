# ── SmartFit mobile (@smartfit/mobile) ───────────────────────────────────
# Expo inlines EXPO_PUBLIC_* vars at build/start time. All are OPTIONAL —
# the app is local-first (AsyncStorage) and needs no backend.

# Seed a demo training history on first launch (no saved data).
EXPO_PUBLIC_SEED_DEMO=false

# Default training strategy: ppl | upper-lower | full-body | cardio-focus
EXPO_PUBLIC_DEFAULT_PLAN=full-body

# App display name.
EXPO_PUBLIC_APP_NAME=SmartFit

# ── Optional cloud sync / push (reserved) ───────────────────────────────
# EXPO_PUBLIC_API_URL=
# EXPO_PUBLIC_FIREBASE_API_KEY=
