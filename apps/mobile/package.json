{
  "name": "@smartfit/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "dev": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "echo '@smartfit/mobile tests covered by @smartfit/core'",
    "prebuild": "expo prebuild",
    "build:dev": "eas build --profile development --platform android",
    "build:preview": "eas build --profile preview --platform android",
    "build:prod": "eas build --profile production --platform android",
    "build:ios-dev": "eas build --profile development --platform ios",
    "build:ios-prod": "eas build --profile production --platform ios",
    "build:all": "eas build --profile production --platform all",
    "submit:android": "eas submit --platform android",
    "submit:ios": "eas submit --platform ios",
    "update": "eas update --branch production"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "1.23.1",
    "@smartfit/core": "workspace:*",
    "clsx": "^2.1.1",
    "expo": "~52.0.0",
    "expo-auth-session": "^57.0.13",
    "expo-build-properties": "~0.13.2",
    "expo-constants": "~17.0.8",
    "expo-crypto": "^57.0.3",
    "expo-dev-client": "~5.0.0",
    "expo-haptics": "~14.0.1",
    "expo-linking": "~7.0.5",
    "expo-local-authentication": "~15.0.1",
    "expo-location": "~18.0.10",
    "expo-router": "~4.0.22",
    "expo-splash-screen": "~0.29.24",
    "expo-status-bar": "~2.0.1",
    "expo-web-browser": "^57.0.3",
    "firebase": "^12.18.0",
    "lucide-react-native": "^0.468.0",
    "nativewind": "~4.1.23",
    "react": "18.3.1",
    "react-native": "0.76.9",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-health-connect": "^3.3.2",
    "react-native-reanimated": "~3.16.1",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-svg": "15.8.0",
    "tailwind-merge": "^3.0.0",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@types/node": "^22.14.0",
    "@types/react": "19.1.10",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.9"
}
